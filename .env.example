# GitLab 配置
# GitLab 实例地址（gitlab.com 或自建实例）
GITLAB_URL=https://gitlab.com
# 访问令牌：需要 api 读权限 + 对目标项目 MR 写评论权限
GITLAB_TOKEN=
# GitLab webhook 中配置的 secret token，用于校验请求头 X-Gitlab-Token
GITLAB_WEBHOOK_SECRET=

# GitHub 配置
# GitHub Personal Access Token：需要 repo 读写权限（用于读取 PR 和发表评论）
GITHUB_TOKEN=
# GitHub webhook 中配置的 secret token，用于校验请求头 X-Hub-Signature-256
GITHUB_WEBHOOK_SECRET=

# LLM 配置（用于 GitHub PR 智能审查）
# OpenAI API Key 或兼容 API 的 Key
OPENAI_API_KEY=
# OpenAI 兼容 API 的基础 URL（可选，留空使用官方 https://api.openai.com）
OPENAI_BASE_URL=
# 使用的模型名称
OPENAI_MODEL=GLM-4.5-Air
# LLM 单次调用最大 token 数
LLM_MAX_TOKENS=4096
# LLM 温度参数（0-1，越小越确定）
LLM_TEMPERATURE=0.2

# 审查行为（可选，以下为默认值）
# 单次 MR/PR 最多审查的文件数
MAX_FILES_PER_REVIEW=50
# 单次 MR/PR 最多发表的行内评论数
MAX_INLINE_COMMENTS=20
# 超过此大小（字节）的文件跳过审查
MAX_FILE_SIZE_BYTES=200000

# 服务监听
HOST=0.0.0.0
PORT=8000
