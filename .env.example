# GitLab 配置
# GitLab 实例地址（gitlab.com 或自建实例）
GITLAB_URL=https://gitlab.com
# 访问令牌：需要 api 读权限 + 对目标项目 MR 写评论权限
GITLAB_TOKEN=
# GitLab webhook 中配置的 secret token，用于校验请求头 X-Gitlab-Token
GITLAB_WEBHOOK_SECRET=

# 审查行为（可选，以下为默认值）
# 单次 MR 最多审查的文件数
MAX_FILES_PER_REVIEW=50
# 单次 MR 最多发表的行内评论数
MAX_INLINE_COMMENTS=20
# 超过此大小（字节）的文件跳过审查
MAX_FILE_SIZE_BYTES=200000

# 服务监听
HOST=0.0.0.0
PORT=8000
